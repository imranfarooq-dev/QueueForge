# QueueForge backend — environment variables
#
# Copy this file to `.env` and adjust as needed for your environment.
# Spring Boot reads these via ${VAR:default} placeholders in application.properties.
#
# Local dev (running ./mvnw spring-boot:run on the host):
#   most defaults already work; you can leave this file empty.
#
# Docker compose (running with --profile app):
#   docker-compose.yml already injects these per-container; this file is just a
#   reference of what the application reads.
#
# Kubernetes:
#   k8s/10-configmap.yaml + k8s/11-secret.yaml carry these into pods.

# ---- HTTP server ----
SERVER_PORT=8080

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=queueforge
DB_USER=queueforge
DB_PASSWORD=queueforge123

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka ----
# When the app runs on the HOST and Kafka is in Docker, use the EXTERNAL listener:
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# When the app runs INSIDE the docker-compose network, use the internal listener:
#KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- CORS (comma-separated list of allowed origins for the frontend) ----
CORS_ALLOWED_ORIGINS=http://localhost:4200
